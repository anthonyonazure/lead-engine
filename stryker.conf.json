{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test"
  },
  "mutate": [
    "server/db.ts",
    "server/index.ts",
    "server/lib/sanitize-input.ts",
    "server/middleware/auth.ts",
    "server/routes/leads.ts",
    "server/routes/webhooks.ts",
    "server/services/email.ts",
    "server/services/sms.ts"
  ],
  "reporters": [
    "progress",
    "clear-text"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
