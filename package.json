{
  "name": "lead-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "check": "bun run typecheck && bun run lint",
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "build:check": "tsc -p server/tsconfig.json --noEmit && vite build --config client/vite.config.ts",
    "start": "tsx server/index.ts",
    "seed": "tsx data/seed.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "postmark": "^4.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.11",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "eslint": "^10.8.0",
    "postcss": "^8.4.47",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@babel/core": ">=7.29.6 <8",
      "axios": ">=1.18.0 <2",
      "body-parser": ">=1.20.6 <2",
      "fast-uri": ">=3.1.5 <4",
      "form-data": ">=4.0.6 <5",
      "postcss": ">=8.5.23 <9",
      "qs": ">=6.15.2 <7",
      "shell-quote": ">=1.9.0 <2",
      "tsx": ">=4.22.0 <5"
    }
  },
  "license": "MIT",
  "overrides": {
    "@babel/core": ">=7.29.6 <8",
    "axios": ">=1.18.0 <2",
    "body-parser": ">=1.20.6 <2",
    "fast-uri": ">=3.1.5 <4",
    "form-data": ">=4.0.6 <5",
    "postcss": ">=8.5.23 <9",
    "qs": ">=6.15.2 <7",
    "shell-quote": ">=1.9.0 <2",
    "tsx": ">=4.22.0 <5"
  }
}
